# Gradle / ModDevGradle
.gradle/
build/
out/
src/generated/resources/.cache/

# Every ModDevGradle run directory. These are generated game installs -- worlds, generated
# configs, eula.txt, caches -- and none of it belongs in the repository. run-server in
# particular would otherwise carry a committed eula.txt, which is not ours to accept on
# anyone's behalf.
run/
run-data/
run-server/
run-gametest/

# Eclipse / IntelliJ / VS Code
*.iml
*.ipr
*.iws
.idea/
.eclipse/
.settings/
.classpath
.project
.vscode/
bin/

# Build/run logs
*.log
*.log.gz
logs/

# Bootstrap scratch (Forge MDK download used only to seed the Gradle wrapper)
.bootstrap/

# Session summaries (local notes, not part of the published mod)
docs/summaries/

# Released/downloaded mod jars kept in the repo root for reference. The gradle wrapper jar
# is tracked on purpose, so this is deliberately narrow rather than a blanket *.jar.
/mcaconversations-*.jar
