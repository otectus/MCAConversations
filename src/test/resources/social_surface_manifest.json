{
  "_comment": [
    "Stability spec 9.4: every surface that can speak to the player, what produces it, which policy decides",
    "what it may assume, what it falls back to, and the test that holds it. Checked by SocialSurfaceManifestTest:",
    "producers and fixtures must exist, and every named pool must exist in both locales."
  ],
  "surfaces": [
    {"surface": "Walk-by greetings", "producer": "dev.otectus.mcaconversations.chat.GreetOnApproach",
     "policy": "chat.GreetingPolicy#pool and #frequency; chat.TownsteadChatPolicy#greeting",
     "pools": ["chatmode.hail.stranger", "chatmode.hail.recognized", "chatmode.hail.respected_stranger",
               "chatmode.hail.acquaintance", "chatmode.hail.friend", "chatmode.hail.confidant",
               "chatmode.hail.partner", "chatmode.hail.family.parent", "chatmode.hail.family.child",
               "chatmode.hail.family.sibling", "chatmode.hail.guarded", "chatmode.hail_cold"],
     "fallback": "chatmode.hail.stranger", "fixture": "dev.otectus.mcaconversations.chat.GreetingPolicyTest"},
    {"surface": "Typed greetings", "producer": "dev.otectus.mcaconversations.chat.ChatModeDispatcher",
     "policy": "chat.GreetingPolicy#pool, the same choice as a walk-by greeting",
     "pools": ["chatmode.hail.stranger", "chatmode.hail.recognized", "chatmode.hail.respected_stranger",
               "chatmode.hail.acquaintance", "chatmode.hail.friend", "chatmode.hail.confidant",
               "chatmode.hail.partner", "chatmode.hail.family.parent", "chatmode.hail.family.child",
               "chatmode.hail.family.sibling", "chatmode.hail.guarded", "chatmode.hail_cold"],
     "fallback": "chatmode.hail.stranger", "fixture": "dev.otectus.mcaconversations.chat.GreetingPolicyTest"},
    {"surface": "Pre-1.8.0 greeting", "producer": "assets/mca_dialogue/lang/en_us.json",
     "policy": "chosen by no band; stranger-safe so an older pack or caller asking for it names nobody",
     "pools": ["chatmode.hail"], "fallback": "chatmode.hail",
     "fixture": "dev.otectus.mcaconversations.content.StrangerSafeSurfaceLintTest"},
    {"surface": "Typed farewells", "producer": "dev.otectus.mcaconversations.chat.ChatModeDispatcher",
     "policy": "chat.GreetingPolicy#farewell",
     "pools": ["chatmode.farewell.stranger", "chatmode.farewell", "chatmode.farewell.family.parent",
               "chatmode.farewell.guarded", "chatmode.farewell.hostile"],
     "fallback": "chatmode.farewell.stranger", "fixture": "dev.otectus.mcaconversations.chat.GreetingPolicyTest"},
    {"surface": "Chat deflections", "producer": "dev.otectus.mcaconversations.chat.ChatModeDispatcher",
     "policy": "stranger-safe by construction: no name, no claim",
     "pools": ["chatmode.attentive", "chatmode.busy", "chatmode.clarify", "chatmode.confused", "chatmode.dropped",
               "chatmode.hint", "chatmode.insult", "chatmode.muted", "chatmode.shrug"],
     "fallback": "chatmode.shrug", "fixture": "dev.otectus.mcaconversations.content.StrangerSafeSurfaceLintTest"},
    {"surface": "Check-in", "producer": "data/mcaconversations/dialogues/greet.json",
     "policy": "social.contact unmet selects the stranger branch; every other branch steps aside",
     "pools": ["conversations.checkin.stranger", "conversations.checkin.stranger.toddler"],
     "fallback": "conversations.checkin.stranger", "fixture": "dev.otectus.mcaconversations.content.StrangerSafeSurfaceLintTest"},
    {"surface": "MCA greet pool extensions", "producer": "assets/mca_dialogue/lang/en_us.json",
     "policy": "stranger-safe by construction", "pools": ["greet.success", "greet.fail"],
     "fallback": "greet.success", "fixture": "dev.otectus.mcaconversations.content.StrangerSafeSurfaceLintTest"},
    {"surface": "Hub and category prompts", "producer": "data/mcaconversations/dialogues/conversations.json",
     "policy": "neutral, audited in 1.8.0",
     "pools": ["conversations.cat.chitchat", "conversations.cat.village", "conversations.cat.personal",
               "conversations.cat.events", "conversations.cat.profession", "conversations.cat.relationships",
               "conversations.cat.townstead"],
     "fallback": "conversations.cat.chitchat", "fixture": "dev.otectus.mcaconversations.content.StrangerSafeSurfaceLintTest"},
    {"surface": "Generated topic and profession scenes", "producer": "src/test/java/dev/otectus/mcaconversations/authoring/TopicPackCompiler.java",
     "policy": "conversation.SocialContract, compiled into scene context.social; named lines refused without requires_known_player_name",
     "pools": [], "fallback": "topic funnel", "fixture": "dev.otectus.mcaconversations.conversation.SocialContractTest"},
    {"surface": "Relationship-gated dialogue", "producer": "dev.otectus.mcaconversations.compat.mca.ConversationsMcaRegistrar",
     "policy": "conversation.SocialPolicy#band behind conversations_relationship", "pools": [],
     "fallback": "stranger band", "fixture": "dev.otectus.mcaconversations.conversation.SocialPolicyTest"},
    {"surface": "Initiatives", "producer": "dev.otectus.mcaconversations.scene.InitiativePlanner",
     "policy": "evidence-bound: a due promise, an unacknowledged rupture, an open thread", "pools": [],
     "fallback": "the ordinary greeting", "fixture": "dev.otectus.mcaconversations.scene.InitiativePlannerTest"},
    {"surface": "Gossip and overheard replies", "producer": "dev.otectus.mcaconversations.gossip.GossipConditionLogic",
     "policy": "chat.UtteranceAudience; gossip told once per listener", "pools": ["conversations.gossip.none"],
     "fallback": "conversations.gossip.none", "fixture": "dev.otectus.mcaconversations.chat.UtteranceAudienceTest"},
    {"surface": "Gift thanks", "producer": "dev.otectus.mcaconversations.gift.GiftTracker",
     "policy": "gratitude scoped to the pair; a need relieved only when Townstead's numbers moved", "pools": [],
     "fallback": "MCA's own gift reaction", "fixture": "dev.otectus.mcaconversations.gift.GiftNeedObservationTest"},
    {"surface": "Nothing new to talk about", "producer": "dev.otectus.mcaconversations.conversation.TopicExhaustion",
     "policy": "topics.hideExhaustedTopics; said once per category page and session, only when every topic entered from that page is hidden because this pair finished it",
     "pools": ["conversations.topics.nothing_new"], "fallback": "the page's own back answer",
     "fixture": "dev.otectus.mcaconversations.conversation.TopicExhaustionTest"},
    {"surface": "Native MCA and other add-ons' lines", "producer": "external",
     "policy": "not owned by this mod; not overridden", "pools": [], "fallback": "", "fixture": ""}
  ]
}
